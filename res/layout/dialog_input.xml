<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_input"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="22.0sp"
        android:textStyle="bold"
        android:textColor="#ff666666"
        android:gravity="center"
        android:id="@id/dialog_input_title"
        android:padding="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="Title" />
    <EditText
        android:textSize="20.0sp"
        android:textColor="#ff6e6e74"
        android:id="@id/dialog_input_name"
        android:background="@drawable/bg_dialog_input_edit"
        android:padding="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20.0dip" />
    <View
        android:background="#ffababab"
        android:layout_width="fill_parent"
        android:layout_height="0.5dip"
        android:layout_above="@id/pop_input_llt" />
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/dialog_input_llt"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18.0sp"
            android:textColor="#ff666666"
            android:gravity="center"
            android:id="@id/pop_input_cancel"
            android:padding="10.0dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_weight="1.0" />
        <View
            android:background="#ffababab"
            android:layout_width="0.5dip"
            android:layout_height="fill_parent" />
        <TextView
            android:textSize="18.0sp"
            android:textColor="#ff666666"
            android:gravity="center"
            android:id="@id/dialog_input_ok"
            android:padding="10.0dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>